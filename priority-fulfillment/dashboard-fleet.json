{
  "displayName": "ComputeClass fulfillment \u2014 fleet",
  "dashboardFilters": [
    {
      "filterType": "METRIC_LABEL",
      "labelKey": "computeclass",
      "templateVariable": "computeclass",
      "stringValue": ".*"
    },
    {
      "filterType": "RESOURCE_LABEL",
      "labelKey": "cluster",
      "templateVariable": "cluster",
      "stringValue": ".*"
    }
  ],
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 3,
        "height": 3,
        "widget": {
          "title": "Fleet: capacity on rule 0 (24h)",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "100 * sum(sum_over_time(ccc_vcpus_by_priority{computeclass=~\"${computeclass.value}\",cluster=~\"${cluster.value}\",kind=\"rule\",priority=\"0\"}[24h])) / sum(sum_over_time(ccc_vcpus_by_priority{computeclass=~\"${computeclass.value}\",cluster=~\"${cluster.value}\",kind=\"rule\"}[24h]))",
              "unitOverride": "%"
            },
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            },
            "thresholds": [
              {
                "value": 80,
                "color": "YELLOW",
                "direction": "BELOW"
              },
              {
                "value": 50,
                "color": "RED",
                "direction": "BELOW"
              }
            ]
          }
        }
      },
      {
        "xPos": 3,
        "yPos": 0,
        "width": 3,
        "height": 3,
        "widget": {
          "title": "Fleet: vCPU-hours on fallback (24h)",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "sum(sum_over_time(ccc_vcpus_by_priority{computeclass=~\"${computeclass.value}\",cluster=~\"${cluster.value}\",kind=\"rule\",priority!=\"0\"}[24h])) / 120 or vector(0)",
              "unitOverride": "1"
            },
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 0,
        "width": 3,
        "height": 3,
        "widget": {
          "title": "Fleet: total vCPU-hours (24h)",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "sum(sum_over_time(ccc_vcpus_by_priority{computeclass=~\"${computeclass.value}\",cluster=~\"${cluster.value}\",kind=\"rule\"}[24h])) / 120 or vector(0)",
              "unitOverride": "1"
            },
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            }
          }
        }
      },
      {
        "xPos": 9,
        "yPos": 0,
        "width": 3,
        "height": 3,
        "widget": {
          "title": "ComputeClasses reporting",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "count(count by (computeclass) (ccc_vcpus_by_priority{computeclass=~\"${computeclass.value}\",cluster=~\"${cluster.value}\"})) or vector(0)",
              "unitOverride": "1"
            },
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 3,
        "width": 3,
        "height": 3,
        "widget": {
          "title": "Clusters NOT stamping the annotation",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "sum(1 - ccc_priority_annotation_supported{cluster=~\"${cluster.value}\"}) or vector(0)",
              "unitOverride": "1"
            },
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            },
            "thresholds": [
              {
                "value": 0.5,
                "color": "RED",
                "direction": "ABOVE"
              }
            ]
          }
        }
      },
      {
        "xPos": 3,
        "yPos": 3,
        "width": 3,
        "height": 3,
        "widget": {
          "title": "Clusters reporting at all",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "count(ccc_exporter_up{cluster=~\"${cluster.value}\"}) or vector(0)",
              "unitOverride": "1"
            },
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 3,
        "width": 6,
        "height": 3,
        "widget": {
          "title": "Unattributable vCPUs by cluster (no annotation support)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (cluster) (ccc_vcpus_by_priority{computeclass=~\"${computeclass.value}\",cluster=~\"${cluster.value}\",kind=\"unsupported\"})",
                  "unitOverride": "1"
                },
                "plotType": "STACKED_AREA",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "vCPUs",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 6,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Fleet vCPUs by priority rule (area = vCPU-hours)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "label_replace(sum by (priority) (ccc_vcpus_by_priority{computeclass=~\"${computeclass.value}\",cluster=~\"${cluster.value}\",kind=\"rule\"}), \"priority\", \"rule $1\", \"priority\", \"(.*)\")",
                  "unitOverride": "1"
                },
                "plotType": "STACKED_AREA",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "vCPUs",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 6,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Fleet vCPUs by ComputeClass (cost attribution)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (computeclass) (ccc_vcpus_by_priority{computeclass=~\"${computeclass.value}\",cluster=~\"${cluster.value}\",kind=\"rule\"})",
                  "unitOverride": "1"
                },
                "plotType": "STACKED_AREA",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "vCPUs",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 10,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Rule 0 share by ComputeClass (%)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "100 * sum by (computeclass) (sum_over_time(ccc_vcpus_by_priority{computeclass=~\"${computeclass.value}\",cluster=~\"${cluster.value}\",kind=\"rule\",priority=\"0\"}[1h])) / sum by (computeclass) (sum_over_time(ccc_vcpus_by_priority{computeclass=~\"${computeclass.value}\",cluster=~\"${cluster.value}\",kind=\"rule\"}[1h]))",
                  "unitOverride": "%"
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "% on rule 0",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 10,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "vCPUs by cluster (multi-cluster rollup)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (cluster) (ccc_vcpus_by_priority{computeclass=~\"${computeclass.value}\",cluster=~\"${cluster.value}\",kind=\"rule\"})",
                  "unitOverride": "1"
                },
                "plotType": "STACKED_AREA",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "vCPUs",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 14,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Rule 0 share by cluster (%)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "100 * sum by (cluster) (sum_over_time(ccc_vcpus_by_priority{computeclass=~\"${computeclass.value}\",cluster=~\"${cluster.value}\",kind=\"rule\",priority=\"0\"}[1h])) / sum by (cluster) (sum_over_time(ccc_vcpus_by_priority{computeclass=~\"${computeclass.value}\",cluster=~\"${cluster.value}\",kind=\"rule\"}[1h]))",
                  "unitOverride": "%"
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "% on rule 0",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 14,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Fleet sentinel + unannotated nodes",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (priority) (ccc_nodes_by_priority{computeclass=~\"${computeclass.value}\",cluster=~\"${cluster.value}\",kind!=\"rule\"})",
                  "unitOverride": "1"
                },
                "plotType": "STACKED_AREA",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "nodes",
              "scale": "LINEAR"
            }
          }
        }
      }
    ]
  }
}
